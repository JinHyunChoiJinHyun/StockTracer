<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stocktracer.backend.investorflow.mapper.InvestorFlowAnalysisMapper">
    <resultMap id="investorFlowAnalysisMap" type="com.stocktracer.backend.investorflow.domain.InvestorFlowAnalysis">
        <constructor>
            <idArg column="base_date" javaType="java.time.LocalDate"/>
            <idArg column="stock_code" javaType="java.lang.String"/>
            <arg column="net_ratio" javaType="java.math.BigDecimal"/>
            <arg column="flow_score" javaType="java.math.BigDecimal"/>
            <arg column="is_double_buy" javaType="_boolean"/>
            <arg column="is_clean_buy" javaType="_boolean"/>
            <arg column="reason" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <!-- 1. 투자자별 순매도액 분석 결과 대량 저장 -->
    <insert id="upsertAll">
        INSERT INTO investor_flow_analysis (
        base_date,
        stock_code,
        net_ratio,
        flow_score,
        is_double_buy,
        is_clean_buy,
        reason
        )
        VALUES
        <foreach collection="flows" item="f" separator=",">
            (
            #{f.baseDate},
            #{f.stockCode},
            #{f.netRatio, jdbcType=DECIMAL}, <!-- null인 경우 처리 방법 안내 미작성 시 JdbcType OTHER 예외 발생 -->
            #{f.flow_score},
            #{f.doubleBuy},
            #{f.cleanBuy},
            #{f.reason, jdbcType=VARCHAR} <!-- null인 경우 처리 방법 안내 -->
            )
        </foreach> AS new <!-- Java 객체의 값을 MyBatis가 SQL 값으로 바인딩하고, foreach로 생성된 데이터 행(가상 테이블)에 'new'라는 별칭 부여 (sql 필드명과 같음) -->
        ON DUPLICATE KEY UPDATE
            net_ratio = new.net_ratio,
            flow_score = new.flow_score,
            is_double_buy = new.is_double_buy,
            is_clean_buy = new.is_clean_buy,
            reason = new.reason
    </insert>
</mapper>