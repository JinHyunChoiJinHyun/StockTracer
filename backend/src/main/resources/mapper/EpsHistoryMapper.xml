<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stocktracer.backend.value.mapper.EpsHistoryMapper">
    <resultMap id="epsPrevMap" type="com.stocktracer.backend.value.domain.EpsHistory">
        <constructor>
            <idArg column="stock_code" javaType="java.lang.String"/>
            <arg column="eps" javaType="java.math.BigDecimal"/>
            <arg column="prev_eps" javaType="java.math.BigDecimal"/>
            <arg column="effective_date" javaType="java.time.LocalDate"/>
            <arg column="prev_effective_date" javaType="java.time.LocalDate"/>
        </constructor>
    </resultMap>

    <sql id="selectCols">
        current.stock_code,
        current.eps,
        prev.eps as prev_eps,
        current.effective_date,
        prev.effective_date as prev_effective_date
    </sql>

    <sql id="lagJoin">
        LEFT JOIN eps_history prev
        ON prev.stock_code = current.stock_code
        AND prev.seq = current.seq - #{lag}
    </sql>

    <select id="findLatestPrev" resultMap="epsPrevMap">
        SELECT <include refid="selectCols"/>
            FROM(
                SELECT stock_code, eps, seq, effectivev_date
        )
    </select>
</mapper>