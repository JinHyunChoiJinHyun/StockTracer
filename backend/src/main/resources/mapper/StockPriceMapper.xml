<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stocktracer.backend.price.mapper.StockPriceMapper">
    <!-- 1. 특정 종목의 기간별 주가 목록 조회 -->
    <!-- 매핑을 위해 조회 순서 중요!-->
    <select id="findPricesByCodeAndPeriod" resultType="com.stocktracer.backend.price.dto.StockPriceResponseDto">
        SELECT
            s.stock_code,
            s.stock_name,
            s.market,
            sp.stock_date,
            sp.open_price,
            sp.close_price,
            sp.low_price,
            sp.high_price,
            sp.price_change,
            sp.volume
        FROM
            stock_price as sp
        JOIN stock_info as s
        on sp.stock_code = s.stock_code
        WHERE sp.stock_code = #{stockCode}
        <if test="startDate != null">
            AND sp.stock_date &gt;= #{startDate}
        </if>
        <if test="endDate != null">
            AND sp.stock_date &lt;= #{endDate}
        </if>
        ORDER BY sp.stock_date ASC
    </select>

    <!-- 2. 여러 종목 동시 조회 -->
    <select id="findPricesByCodes" resultType="com.stocktracer.backend.price.dto.StockPriceResponseDto">
        SELECT
            s.stock_code,
            s.stock_name,
            s.market,
            sp.stock_date,
            sp.open_price,
            sp.close_price,
            sp.low_price,
            sp.high_price,
            sp.price_change,
            sp.volume
        FROM
            stock_price as sp
        JOIN stock_info as s
        on sp.stock_code = s.stock_code
        WHERE sp.stock_code IN
        <foreach item="code" collection="stockCodes" open="(" separator="," close=")">
            #{code}
        </foreach>
        AND sp.stock_date = #{priceDate}
        <choose>
            <when test="sortBy == 'volume'">
                ORDER BY sp.volume DESC
            </when>
            <when test="sortBy == 'openPrice'">
                ORDER BY sp.open_price DESC
            </when>
            <when test="sortBy == 'closePrice'">
                ORDER BY sp.close_price DESC
            </when>
            <when test="sortBy == 'stockName'">
                ORDER BY s.stock_name DESC
            </when>
            <otherwise>
                ORDER BY sp.stock_code ASC
            </otherwise>
        </choose>
    </select>
    <!-- 3. 주가 데이터 대량 저장 -->
    <!-- mysql -->
    <insert id="bulkUpsert">
        INSERT INTO stock_price
        (
         stock_code,
         stock_date,
         open_price,
         close_price,
         low_price,
         high_price,
         price_change,
         volume
        )
        VALUES
        <foreach collection="prices" item="p" separator=",">
            (
             #{p.stockCode},
             #{p.stockDate},
             #{p.openPrice},
             #{p.closePrice},
             #{p.lowPrice},
             #{p.highPrice},
             #{p.priceChange},
             #{p.volume}
            )
        </foreach> AS new_val
        ON DUPLICATE KEY UPDATE
            open_price = new_val.open_price,
            high_price = new_val.high_price,
            low_price = new_val.low_price,
            close_price = new_val.close_price,
            price_change = new_val.price_change,
            volume = new_val.volume
    </insert>
